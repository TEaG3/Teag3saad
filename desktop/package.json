{
  "name": "saad-ps2-desktop",
  "version": "1.1.0",
  "description": "Saad PS2 Ultimate Windows desktop application",
  "main": "main.cjs",
  "author": "Saad PS2",
  "license": "UNLICENSED",
  "scripts": {
    "stage": "node scripts/stage-site.cjs",
    "smoke": "electron . --smoke-test",
    "test": "node ../tests/validate.js",
    "dist:setup": "npm run stage && electron-builder --win nsis --x64 --config.win.artifactName=Saad-PS2-Setup-${version}.${ext}",
    "dist:win": "npm run dist:setup"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.1"
  },
  "overrides": {
    "tar": "7.5.22"
  },
  "build": {
    "appId": "com.saadps2.ultimate",
    "productName": "Saad PS2 Ultimate",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app-site",
        "to": "app-site",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Saad-PS2-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Saad PS2 Ultimate"
    }
  }
}
